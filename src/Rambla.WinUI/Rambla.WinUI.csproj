<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Rambla.WinUI</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Rambla.WinUI</PackageId>
    <Description>WinUI 3 dispatcher scheduler adapter for Rambla. Marshals coalesced state flushes onto the UI thread via the Windows App SDK DispatcherQueue.</Description>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rambla\Rambla.csproj" />
    <InternalsVisibleTo Include="Rambla.WinUI.Tests" />
  </ItemGroup>

</Project>
