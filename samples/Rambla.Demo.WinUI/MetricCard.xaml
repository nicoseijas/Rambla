<UserControl
    x:Class="Rambla.Demo.WinUI.MetricCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
            <TextBlock Text="{x:Bind Value, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" />
        </StackPanel>
    </Border>
</UserControl>
