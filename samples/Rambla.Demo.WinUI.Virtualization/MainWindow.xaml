<Window
    x:Class="Rambla.Demo.WinUI.Virtualization.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rambla — WinUI data virtualization">

    <Grid Padding="20" RowSpacing="14" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="500,000 logical quotes · 420 cached rows" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Drag the scrollbar anywhere: ListView retains the full extent while the source fetches only the viewport and its 200-row buffer on either side." TextWrapping="Wrap" Opacity="0.7" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="Refresh cache metrics" Click="OnRefreshMetrics" />
            <TextBlock x:Name="CacheMetrics" Grid.Column="1" VerticalAlignment="Center" Opacity="0.7" />
        </Grid>

        <ListView x:Name="Quotes" Grid.Row="2" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Height" Value="28" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.Header>
                <Grid Padding="8,4" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Index" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Symbol" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Bid" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Last" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="State" FontWeight="SemiBold" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,4" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Index}" />
                        <TextBlock Grid.Column="1" Text="{Binding Symbol}" />
                        <TextBlock Grid.Column="2" Text="{Binding Bid}" />
                        <TextBlock Grid.Column="3" Text="{Binding Last}" />
                        <TextBlock Grid.Column="4" Text="{Binding Status}" Opacity="0.7" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="3" Text="Rows have a fixed 28 px height so the scrollbar position maps exactly to logical indices. Variable heights need a separate height-estimation strategy." TextWrapping="Wrap" Opacity="0.7" />
    </Grid>
</Window>
